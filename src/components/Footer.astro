---
import Default from '@astrojs/starlight/components/Footer.astro';
---
<Default><slot /></Default>
<adc-ask
  collection="adc_docs"
  subtitle="Answers from the ADC docs"
  placeholder="Ask about any widget"
  welcome="Ask how to set up or use an ADC widget."
></adc-ask>
<script>
  import '@arielladigitalconsulting/adc-ask';
  import { initConsent } from '../scripts/consent';

  // Starlight isolates the main pane in its own stacking context, which puts the launcher under the fixed table of
  // contents on every page that has one. Hosting it on the body keeps it above, and clickable.
  document.querySelectorAll('adc-ask').forEach((el) => document.body.append(el));

  // Measurement IDs are public; PUBLIC_GA_ID overrides it (set it empty to disable analytics)
  // The proxy runs on Cloud Run and scales to zero. Any request starts an instance, even one that answers 404, so ping
  // the service root on load, on focus and every minute while the page is visible to keep the first question fast.
  const proxy = 'https://chatgpt-proxy-530008831989.us-central1.run.app/';
  const wake = () => {
    if (document.visibilityState === 'visible') fetch(proxy, { mode: 'no-cors', cache: 'no-store' }).catch(() => {});
  };
  wake();
  addEventListener('focus', wake);
  setInterval(wake, 60_000);

  initConsent(import.meta.env.PUBLIC_GA_ID ?? 'G-4Q9C8455PM');

  // Keeps the assistant and the search bar on the theme chosen in the site's switcher
  const root = document.documentElement;
  const syncTheme = () =>
    document.querySelectorAll('adc-ask, adc-search').forEach((el) => el.setAttribute('theme', root.dataset.theme || 'light'));
  syncTheme();
  new MutationObserver(syncTheme).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
</script>
